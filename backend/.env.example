# ── Environment Variables — Backend ─────────────────────────────────────────
# Copy this file to .env and fill in the values.
# NEVER commit your actual .env file to version control.
#
# For Vercel deployment, add these via:
#   Vercel Dashboard → Project → Settings → Environment Variables
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (Supabase PostgreSQL) ───────────────────────────────────────────
# Transaction-mode pooler — used by the application at runtime
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"

# Session-mode / direct connection — used by Prisma Migrate
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# ── Authentication ────────────────────────────────────────────────────────────
# Generate a strong random secret: openssl rand -hex 64
JWT_SECRET=""

# ── Supabase Storage (S3-compatible) ─────────────────────────────────────────
S3_ENDPOINT="https://<project-ref>.storage.supabase.co/storage/v1/s3"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_REGION="ap-northeast-1"
S3_BUCKET="bucket"

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins in production.
# Example: https://sikasur.vercel.app,https://www.sikasur.id
ALLOWED_ORIGINS=""

# ── SMTP / Mailer (Nodemailer) ────────────────────────────────────────────────
# Used for sending emails (Forgot Password, Notifications, etc.)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV="production"
